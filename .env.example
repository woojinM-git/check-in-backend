# ============================================
# 백엔드 환경 변수 설정 예시 파일
# ============================================
# 사용 방법:
# 1. 이 파일을 .env로 복사: cp .env.example .env
# 2. 실제 값으로 채워넣기
# 3. .env 파일은 Git에 커밋하지 않도록 주의 (.gitignore에 포함됨)
# ============================================

# ============================================
# 데이터베이스 설정
# ============================================
DB_URL=jdbc:mysql://localhost:3306/checkin?useSSL=false&serverTimezone=Asia/Seoul&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ============================================
# JWT 설정
# ============================================
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# ============================================
# Toss Payments 설정
# ============================================
TOSS_SECRET_KEY=your_toss_secret_key
TOSS_CLIENT_KEY=your_toss_client_key

# ============================================
# Gmail SMTP 설정
# ============================================
GMAIL_USERNAME=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# ============================================
# AWS S3 설정
# ============================================
AWS_S3_ACCESS_KEY=your_aws_access_key
AWS_S3_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_S3_REGION=ap-northeast-2

# ============================================
# OAuth2 설정
# ============================================
# Naver OAuth2
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
NAVER_STATE=your_naver_state_string

# Kakao OAuth2
KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_CLIENT_SECRET=your_kakao_client_secret

# ============================================
# API URL 설정
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8888
CORS_ALLOWED_ORIGINS=http://localhost:3333,http://localhost:3000
SERVER_DOMAIN=localhost:8888

# ============================================
# 프론트엔드 URL 설정
# ============================================
FRONTEND_URL_DEV=http://localhost:3333
FRONTEND_URL_PROD=https://checkinn.store
